{
  "name": "promo-forge-template",
  "version": "1.0.0",
  "private": true,
  "description": "promo-forge 视频工程模板：Remotion + 免费配音 + 自动校验闸门",
  "license": "MIT",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "lint": "tsc --noEmit",
    "doctor": "python scripts/doctor.py",
    "capture": "python scripts/capture.py",
    "media": "python scripts/media.py",
    "music": "python scripts/music.py",
    "tts": "python scripts/tts.py all",
    "mix": "python scripts/mix.py",
    "stills": "node scripts/stills.mjs",
    "sheet": "python scripts/media.py sheet out/stills --cols 4",
    "check:assets": "python scripts/check_assets.py",
    "check:video": "python scripts/check_video.py out/final-1080p.mp4",
    "check:video:strict": "python scripts/check_video.py out/final-1080p.mp4 --strict",
    "render:preview": "remotion render src/index.ts PromoPreview out/preview.mp4 --concurrency=12 --crf=20 > out/render.log 2>&1",
    "render:1080": "remotion render src/index.ts Promo out/final-1080p.mp4 --concurrency=12 --crf=14 > out/render.log 2>&1",
    "render:4k": "remotion render src/index.ts Promo out/final-4k.mp4 --scale=2 --concurrency=6 --crf=14 > out/render.log 2>&1",
    "web": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:serve": "http-server out/web -p 18765 -a 127.0.0.1 -c-1"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/player": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "http-server": "^14.1.1",
    "typescript": "5.9.3",
    "vite": "^6.4.3"
  }
}
