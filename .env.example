# 复制一份改名为 .env 放在项目根目录（已在 .gitignore 里），或直接设置环境变量。
# 全部可选：不填也能做出完整成片（配音走免费的 edge-tts，配乐走本地免费曲库）。

# 可选：ElevenLabs，音色更自然、可作曲。填了才启用 scripts/tts.py --engine eleven
ELEVENLABS_API_KEY=

# 可选：给 Playwright 下载浏览器时用的国内镜像
# PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright

# 可选：网络需要代理时（capture.py / music.py 下载会用到）
# HTTPS_PROXY=http://127.0.0.1:7890
